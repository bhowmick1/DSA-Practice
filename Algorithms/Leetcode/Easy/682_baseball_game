class Solution {
public:
    int calPoints(vector<string>& operations) {
        
        stack<int>st;
        int res=0;

        for(string c:operations){
            if(c=="C"){
             st.pop();
            }
            else if(c=="D"){
                st.push(2*st.top());
            }
            else if(c=="+"){
                int first=st.top();
                st.pop();
                int second=st.top();
                st.push(first);
                st.push(first+second);
            }
            else{
                st.push(stoi(c));
            }

        }
        int sum=0;
        while(!st.empty()){
        sum+=st.top();
        st.pop();
        }
  return sum;
    }
};